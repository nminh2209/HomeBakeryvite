# Optional: copy to .env and set values to override defaults (do not commit .env).
# Builds without any VITE_* set still work for this bakery project — Firebase client
# keys are public; security is Firestore rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bakery-4c2f2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bakery-4c2f2
VITE_FIREBASE_STORAGE_BUCKET=bakery-4c2f2.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=bakery
VITE_CLOUDINARY_FOLDER=samples/ecommerce
