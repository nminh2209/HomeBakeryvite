# Copy this file to `.env` in the project root (do not commit `.env`).
# Vite injects these at build/dev time via import.meta.env.
#
# --- Firebase (project: bakery-4c2f2) ---
# Open: https://console.firebase.google.com/project/bakery-4c2f2/settings/general
# Scroll to "Your apps" → Web app → "SDK setup and configuration" → Config object.
# Copy each field into the matching VITE_* variable below.
#
# Required for auth (leave empty only if you rely on built-in fallbacks in src/firebase.ts):
#   apiKey            → VITE_FIREBASE_API_KEY
#   authDomain        → VITE_FIREBASE_AUTH_DOMAIN
#   projectId         → VITE_FIREBASE_PROJECT_ID
#   storageBucket     → VITE_FIREBASE_STORAGE_BUCKET
#   messagingSenderId → VITE_FIREBASE_MESSAGING_SENDER_ID
#   appId             → VITE_FIREBASE_APP_ID
#   measurementId     → VITE_FIREBASE_MEASUREMENT_ID  (optional, Analytics)
#
# Production (Vercel): Project Settings → Environment Variables → same names, then redeploy.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bakery-4c2f2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bakery-4c2f2
VITE_FIREBASE_STORAGE_BUCKET=bakery-4c2f2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Cloudinary (unsigned upload preset) ---
# Dashboard: https://console.cloudinary.com → Settings → Upload → Upload presets
#   cloud name     → VITE_CLOUDINARY_CLOUD_NAME
#   upload preset  → VITE_CLOUDINARY_UPLOAD_PRESET
#   folder         → VITE_CLOUDINARY_FOLDER (optional path prefix)

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=bakery
VITE_CLOUDINARY_FOLDER=samples/ecommerce
