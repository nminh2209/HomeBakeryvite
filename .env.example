# Copy to `.env` in the project root (do not commit `.env`).
# All values are required for dev/build except VITE_FIREBASE_MEASUREMENT_ID (Analytics).
#
# Firebase: https://console.firebase.google.com/project/bakery-4c2f2/settings/general
#   Web app → SDK setup → copy into matching VITE_* below.
# Cloudinary: https://console.cloudinary.com → Settings → Upload presets
#
# Vercel / GitHub Actions: add the same variable names in Environment Variables / Secrets.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=
